#!/usr/bin/env sh

# Helper for the p3_* missions (github / ssh / push / pull / pull request).
#
# Unlike every other mission, those need things GameShell cannot provide:
# network access to github.com, a GitHub account, an ssh key registered there
# and a personal fork of the "gitlectures" repository.  They ask this script
# whether they can be played at all and, when the answer is no, cancel
# themselves -- an init.sh exiting with a non-zero status makes GameShell skip
# the mission.
#
# Usage:
#   gsh_github reachable   github.com answers on the ssh port
#   gsh_github ssh         ... and accepts one of our ssh keys
#   gsh_github fork        the address of the player's fork is known
#
# Set GSH_SKIP_GITHUB to a non-empty value to skip the GitHub missions without
# even trying.  The test suite does this, since no automated run can have a
# personal fork to push to.

if [ -n "$GSH_SKIP_GITHUB" ]
then
    exit 1
fi

# Talk to github and print what it answered.  GitHub always closes the
# connection, so ssh never exits with 0: what matters is what it printed.
# BatchMode stops ssh from asking for a passphrase on the terminal, which
# would otherwise hang the game.
ssh_github() {
    ssh -T \
        -o BatchMode=yes \
        -o StrictHostKeyChecking=no \
        -o ConnectTimeout=10 \
        "$@" \
        git@github.com 2>&1
}

case $1 in
    reachable)
        # Answering "can we reach github at all?" must not touch any of the
        # player's keys.  Left to itself, ssh offers every key it can find,
        # and on macOS unlocking a passphrase stored in the login keychain
        # pops up a system dialog -- asking for a password at startup, before
        # the player has done anything, is alarming and inexplicable.
        #   -F /dev/null           ignore ~/.ssh/config (UseKeychain, ...)
        #   IdentityFile           a file that does not exist replaces the
        #                          default ~/.ssh/id_* identities
        #   IdentitiesOnly         ... and keeps ssh from looking further
        #   IdentityAgent=none     do not ask ssh-agent either
        #   UserKnownHostsFile     do not touch the player's known_hosts
        # github then answers "Permission denied (publickey)", which proves
        # just as well that we reached it.
        #
        # A cancelled mission makes the next one ask again, so without the
        # cache an offline laptop would wait for the timeout once per GitHub
        # mission before the game even starts.
        cache=""
        if [ -n "$GSH_CONFIG" ] && [ -d "$GSH_CONFIG" ]
        then
            cache=$GSH_CONFIG/github_reachable
            if [ -f "$cache" ] && [ -n "$(find "$cache" -mmin -1 2>/dev/null)" ]
            then
                exit "$(cat "$cache")"
            fi
        fi

        ssh_github \
            -F /dev/null \
            -o IdentitiesOnly=yes \
            -o IdentityAgent=none \
            -o IdentityFile=/nonexistent \
            -o UserKnownHostsFile=/dev/null |
            grep -q -e "successfully authenticated" -e "Permission denied"
        status=$?

        [ -n "$cache" ] && echo "$status" > "$cache"
        exit "$status"
        ;;
    ssh)
        # This one has to use a key: whether github accepts the one the player
        # registered is exactly what it checks.
        #
        # It must be the key the game set up, though.  GameShell points HOME at
        # its World directory, but ssh does not follow: it resolves ~/.ssh from
        # the password database, so without -F it reads the player's real
        # configuration and offers their real keys -- and the mission would
        # pass while connected as some other account entirely.
        if [ -f "$GSH_HOME/.ssh/config" ]
        then
            ssh_github -F "$GSH_HOME/.ssh/config" | grep -q "successfully authenticated"
        else
            ssh_github | grep -q "successfully authenticated"
        fi
        ;;
    fork)
        [ -s "$GSH_HOME/.fork" ]
        ;;
    *)
        echo "Usage: $(basename "$0") reachable|ssh|fork" >&2
        exit 2
        ;;
esac
